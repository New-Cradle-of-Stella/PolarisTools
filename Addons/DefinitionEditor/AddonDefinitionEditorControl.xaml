<UserControl x:Class="PolarisTools.Addons.DefinitionEditor.AddonDefinitionEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:authoring="clr-namespace:Polaris.Addons.Authoring"
             mc:Ignorable="d" d:DesignHeight="560" d:DesignWidth="1040"
             Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"
             Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="boolToVis"/>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="Margin" Value="0,3,0,11"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Margin" Value="0,3,0,11"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="0.72"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
        </Style>
        <Style x:Key="Help" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.68"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,-5,0,12"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="6"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 三种文件共用同一工作台，只用这条类型轨道建立清晰识别。 -->
        <Border Grid.Row="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#4DA3FF"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static authoring:AddonDocumentKind.Plugin}">
                            <Setter Property="Background" Value="#D8903B"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="{x:Static authoring:AddonDocumentKind.Skill}">
                            <Setter Property="Background" Value="#A677D4"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <Grid Grid.Row="1" Margin="18,15,18,13">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Polaris Addons definition" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding TypeLabel}" Margin="0,3,0,0" Opacity="0.72"/>
            </StackPanel>
            <Border Grid.Column="1" Padding="10,5" CornerRadius="2"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}">
                <TextBlock Text="generated registration" FontFamily="Consolas" Opacity="0.75"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Margin="18,0,18,12" Padding="9,7"
                Visibility="{Binding IsReadOnly, Converter={StaticResource boolToVis}}"
                BorderThickness="1" BorderBrush="#B55A5A" Background="#245A3030">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Opened read-only · " FontWeight="SemiBold"/>
                <Run Text="{Binding StatusMessage}"/>
            </TextBlock>
        </Border>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <Grid Margin="18,0,18,12" IsEnabled="{Binding IsEditable}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*" MinWidth="240"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1.1*" MinWidth="250"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="1.2*" MinWidth="280"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="1" Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}" Margin="18,0"/>
                <Border Grid.Column="3" Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}" Margin="18,0"/>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="IDENTITY"/>
                    <TextBlock Text="Stable Id"/>
                    <TextBox Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                    <TextBlock Style="{StaticResource Help}" Text="Lowercase and namespaced. Published ids must not be renamed."/>

                    <StackPanel Visibility="{Binding IsItem, Converter={StaticResource boolToVis}}">
                        <TextBlock Text="Category"/>
                        <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Price"/>
                                <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Stack limit"/>
                                <TextBox Text="{Binding StackLimit, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsItem}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Owner item Id"/>
                        <TextBox Text="{Binding ItemId, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                        <TextBlock Style="{StaticResource Help}" Text="This facet is assembled back into the matching .pitem root."/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="PRESENTATION"/>
                    <StackPanel Visibility="{Binding IsItem, Converter={StaticResource boolToVis}}">
                        <TextBlock Text="Name localization key"/>
                        <TextBox Text="{Binding NameKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsItem}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Title localization key"/>
                        <TextBox Text="{Binding TitleKey, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <TextBlock Text="Description localization key"/>
                    <TextBox Text="{Binding DescriptionKey, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Text="Icon resource Id"/>
                    <TextBox Text="{Binding Icon, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Style="{StaticResource Help}" Text="Keys remain references; PolarisLang and PolarisRes own the actual content."/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Style="{StaticResource SectionLabel}" Text="BEHAVIOR &amp; POLICY"/>
                    <TextBlock Text="Behavior type"/>
                    <TextBox Text="{Binding BehaviorType, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                    <TextBlock Style="{StaticResource Help}" Text="Optional fully qualified C# type. The generated provider registers it; Addons IoC creates it and injects its constructor dependencies."/>

                    <StackPanel Visibility="{Binding IsPlugin, Converter={StaticResource boolToVis}}">
                        <TextBlock Text="Slot cost"/>
                        <TextBox Text="{Binding Cost, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource Help}" Text="The native adapter projects this value into the Enhancer surface."/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsSkill, Converter={StaticResource boolToVis}}">
                        <TextBlock Text="Skill mode"/>
                        <ComboBox ItemsSource="{Binding SkillModes}" SelectedItem="{Binding SkillMode}"/>
                        <TextBlock Text="Unlock policy"/>
                        <ComboBox ItemsSource="{Binding UnlockPolicies}" SelectedItem="{Binding UnlockPolicy}"/>
                        <TextBlock Text="Cooldown seconds"/>
                        <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Text="Concurrency group"/>
                        <TextBox Text="{Binding ConcurrencyGroup, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas"/>
                        <TextBlock Style="{StaticResource Help}" Text="Active skills in the same concurrency group cannot overlap. Empty uses the skill Id."/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="4" Margin="18,0,18,14" Padding="9,7" Background="#22C46A6A"
                BorderBrush="#88C46A6A" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Hint}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Hint}" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</UserControl>
