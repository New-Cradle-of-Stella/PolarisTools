<Project>

  <Import Project="Directory.Build.props.user" Condition="Exists('Directory.Build.props.user')" />

  <PropertyGroup>
    <!--
      Polaris（运行时库）与 PolarisTools（本仓库，VS 扩展）约定并排 clone 在同一个父目录下。
      PolarisTools 把 Polaris 里几个"两侧必须字字一致"的源文件链接进来编译，让编辑器和游戏内
      运行时永远共用同一份代码（具体是哪几个文件、为什么，见 PolarisTools.csproj 里的注释）；
      这里只是把那个相对路径提出来，好在缺失时给出能看懂的报错，而不是一串 CS2001。

      优先级：Directory.Build.props.user > 兄弟目录默认值。不再读环境变量——两个仓库并排 clone
      是唯一支持的布局，少一个环境变量要配置。
    -->
    <PolarisDir Condition="'$(PolarisDir)' == ''">$(MSBuildThisFileDirectory)..\Polaris</PolarisDir>

    <!-- PolarisMagic 是 Polaris 下的一个 git submodule；.pmagic 的文档模型与校验从这里链接过来。 -->
    <PolarisMagicDir Condition="'$(PolarisMagicDir)' == ''">$(PolarisDir)\PolarisMagic</PolarisMagicDir>

    <!-- 三种 Addons 定义格式同样复用运行时仓库中的纯 BCL 文档模型。 -->
    <PolarisAddonsDir Condition="'$(PolarisAddonsDir)' == ''">$(PolarisDir)\PolarisAddons</PolarisAddonsDir>
  </PropertyGroup>

  <Target Name="CheckPolarisDir" BeforeTargets="CoreCompile">
    <Error Condition="!Exists('$(PolarisDir)\PolarisLang\Lang\PlangEntry.cs')"
           Text="Cannot find the Polaris sources: $(PolarisDir)&#xA;Polaris and PolarisTools are expected to be cloned side by side under the same parent directory -- this repository links several source files from there into its own compilation (the .plang memory model, the PUI hot reload wire protocol, and the &quot;leading &amp; = localization key&quot; rule). Clone Polaris next to this repository (as a sibling ..\Polaris directory), or override the PolarisDir MSBuild property in Directory.Build.props.user." />
    <Error Condition="!Exists('$(PolarisMagicDir)\Authoring\MagicDefinitionDocument.cs')"
           Text="Cannot find the PolarisMagic authoring sources: $(PolarisMagicDir)\Authoring\MagicDefinitionDocument.cs&#xA;PolarisMagic is a git submodule of the Polaris superproject; run &quot;git submodule update --init PolarisMagic&quot; inside $(PolarisDir), or override the PolarisMagicDir MSBuild property in Directory.Build.props.user." />
    <Error Condition="!Exists('$(PolarisAddonsDir)\Authoring\AddonDocuments.cs')"
           Text="Cannot find the PolarisAddons authoring sources: $(PolarisAddonsDir)\Authoring\AddonDocuments.cs&#xA;Initialize the PolarisAddons submodule or override PolarisAddonsDir in Directory.Build.props.user." />
  </Target>

</Project>
