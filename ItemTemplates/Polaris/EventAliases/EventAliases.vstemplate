<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Polaris Event Aliases</Name>
    <Description>Alias definitions (actors/positions/boxStyles/audio.sfx/events) for Polaris Event scripts (.phxx)</Description>
    <DefaultName>polaris.events.yaml</DefaultName>
    <ProjectType>CSharp</ProjectType>
    <SortOrder>101</SortOrder>
    <TemplateGroupID>Polaris</TemplateGroupID>
  </TemplateData>
  <TemplateContent>
    <ProjectItem TargetFileName="$fileinputname$" ReplaceParameters="false">polaris.events.yaml</ProjectItem>
  </TemplateContent>
</VSTemplate>
