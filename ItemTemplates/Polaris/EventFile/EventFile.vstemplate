<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Polaris Event Script</Name>
    <Description>Polaris Event scripting file (.phxx, 哈++)</Description>
    <DefaultName>NewEvent.phxx</DefaultName>
    <ProjectType>CSharp</ProjectType>
    <SortOrder>100</SortOrder>
    <TemplateGroupID>Polaris</TemplateGroupID>
  </TemplateData>
  <TemplateContent>
    <ProjectItem TargetFileName="$fileinputname$.phxx" ReplaceParameters="false">Template.phxx</ProjectItem>
  </TemplateContent>
</VSTemplate>
