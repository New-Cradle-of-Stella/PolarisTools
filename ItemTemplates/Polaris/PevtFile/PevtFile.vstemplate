<?xml version="1.0" encoding="utf-8"?>
<VSTemplate Version="3.0.0" Type="Item" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005">
  <TemplateData>
    <Name>Polaris Event File</Name>
    <Description>Polaris PEVT event script (.pevt)</Description>
    <DefaultName>NewEvent.pevt</DefaultName>
    <ProjectType>CSharp</ProjectType>
    <SortOrder>110</SortOrder>
    <TemplateGroupID>Polaris</TemplateGroupID>
  </TemplateData>
  <TemplateContent>
    <ProjectItem TargetFileName="$fileinputname$.pevt" ReplaceParameters="true">Template.pevt</ProjectItem>
  </TemplateContent>
</VSTemplate>
