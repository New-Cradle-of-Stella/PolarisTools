<UserControl x:Class="PolarisTools.Lang.PlangEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:icons="clr-namespace:PolarisTools.Pui.PuiVisualEditor.Controls"
             mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="900"
             Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"
             Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 工具栏按钮/输入框/对话框按钮那套共用外观，见 PlangEditorTheme.xaml。 -->
                <ResourceDictionary Source="pack://application:,,,/PolarisTools;component/Lang/PlangEditorTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="boolToVis"/>

            <!-- ==================== 表格 ==================== -->

            <!-- 表头：跟 VS 里那些网格一样是平的——一层浅底色 + 一根分隔线，没有渐变没有立体边框。
                 这里只改属性不换模板，好让默认模板自带的排序标记和列宽拖拽把手继续工作。 -->
            <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{DynamicResource {x:Static platformui:HeaderColors.DefaultBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:HeaderColors.DefaultTextBrushKey}}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:HeaderColors.SeparatorLineBrushKey}}"/>
                <Setter Property="BorderThickness" Value="0,0,1,1"/>
                <Setter Property="Padding" Value="9,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="SeparatorBrush" Value="{DynamicResource {x:Static platformui:HeaderColors.SeparatorLineBrushKey}}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformui:HeaderColors.MouseOverBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:HeaderColors.MouseOverTextBrushKey}}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 行：整行高亮跟着 VS 的树/列表走（选中态还分"面板有没有焦点"，和解决方案资源管理器一致）。 -->
            <Style x:Key="GridRowStyle" TargetType="DataGridRow">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMenuItemMouseOverBrushKey}}"/>
                    </Trigger>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformui:TreeViewColors.SelectedItemInactiveBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:TreeViewColors.SelectedItemInactiveTextBrushKey}}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource {x:Static platformui:TreeViewColors.SelectedItemActiveBrushKey}}"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:TreeViewColors.SelectedItemActiveTextBrushKey}}"/>
                    </MultiTrigger>
                </Style.Triggers>
            </Style>

            <!-- 单元格：默认模板不认 Padding、选中时还自己刷一层系统高亮色和虚线焦点框（那是 XP 时代
                 的观感）。换成一个只有 Border+内容的模板：内边距生效、背景一律透明让行的高亮透上来。 -->
            <!--
                Background/Foreground 这两个必须显式给值：WPF 里控件的主题默认样式并不会因为我们
                指定了 CellStyle 就整份失效，它只是退到更低的优先级——默认样式里那条
                "IsSelected → SystemColors.Highlight*" 触发器仍然会对我们没有设过的属性生效
                （已用 DependencyPropertyHelper.GetValueSource 核实过是 DefaultStyleTrigger）。
                结果就是选中行的底色是我们的浅色、字却是系统高亮色的白，白底浅蓝上几乎看不见。
                自己把选中态的前景色一并接管，颜色跟行的底色同源（都取 TreeViewColors），亮/暗
                主题下对比度都由 VS 保证。
            -->
            <Style x:Key="GridCellStyle" TargetType="DataGridCell">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="9,6"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Top"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:TreeViewColors.SelectedItemInactiveTextBrushKey}}"/>
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsSelected" Value="True"/>
                            <Condition Property="Selector.IsSelectionActive" Value="True"/>
                        </MultiTrigger.Conditions>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:TreeViewColors.SelectedItemActiveTextBrushKey}}"/>
                    </MultiTrigger>
                    <!-- 编辑中的那一格留窄一点的内边距，让编辑框有地方描边。 -->
                    <Trigger Property="IsEditing" Value="True">
                        <Setter Property="Padding" Value="6,3"/>
                        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextBrushKey}}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 文案单元格：一律按可换行文本显示，行高跟着内容长，最多三行左右就够看个大概，
                 完整内容进单元格编辑或者用"放大编辑"看。 -->
            <Style x:Key="TextCellStyle" TargetType="TextBlock">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="MaxHeight" Value="52"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
            </Style>

            <!-- 编辑态：AcceptsReturn 让回车就是换行（不是"提交并跳下一行"），这正是"固定都是
                 可以换行的文本"该有的手感；Tab/点别处提交，Esc 取消。 -->
            <Style x:Key="TextCellEditStyle" TargetType="TextBox">
                <Setter Property="AcceptsReturn" Value="True"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="MaxHeight" Value="160"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Padding" Value="3,2"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderFocusedBrushKey}}"/>
                <Setter Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBackgroundFocusedBrushKey}}"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextBrushKey}}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextBrushKey}}"/>
            </Style>

            <!-- Key 是标识符不是文案：等宽、不换行、超长省略号，不参与"可换行"那套。 -->
            <Style x:Key="KeyCellStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style x:Key="KeyCellEditStyle" TargetType="TextBox" BasedOn="{StaticResource TextCellEditStyle}">
                <Setter Property="FontFamily" Value="Consolas"/>
                <Setter Property="AcceptsReturn" Value="False"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
            </Style>

            <!-- ==================== 语言条 ==================== -->

            <!-- chip 主体就是个 ToggleButton：点一下停用/启用这门语言（停用只是收起那一列，不丢文案）。 -->
            <Style x:Key="LanguageChipToggleStyle" TargetType="ToggleButton">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Padding="9,3,6,3">
                                <ContentPresenter VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 启用的语言：主题强调色描边+浅底；停用的：灰身、压暗，一眼能分出来。 -->
            <Style x:Key="LanguageChipBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="11"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.AccentMediumBrushKey}}"/>
                <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.AccentPaleBrushKey}}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Opacity" Value="0.6"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 命令栏 ==================== -->
        <Border Grid.Row="0" Padding="4,0"
                BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <!-- 搜索框先声明：DockPanel 是按声明顺序分地方的，先占住右边这一块，窗口窄下来时
                     被挤掉的是最右边那几个按钮，而不是搜索框。 -->
                <Grid DockPanel.Dock="Right" Width="210" Margin="6,5,4,5">
                    <TextBox x:Name="SearchBox" Style="{StaticResource PlangTextBoxStyle}"
                             Padding="26,4,22,4" TextChanged="SearchBox_TextChanged"/>
                    <Path Style="{StaticResource PlangSmallIconStyle}" Data="{x:Static icons:PuiIconCatalog.Search}"
                          HorizontalAlignment="Left" Margin="8,0,0,0" Opacity="0.6" IsHitTestVisible="False"/>
                    <TextBlock Text="搜索 Key 或文案" Margin="27,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource PlangWatermarkStyle}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button HorizontalAlignment="Right" Margin="0,0,3,0"
                            Click="ClearSearch_Click" ToolTip="清空搜索">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PlangIconButtonStyle}">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Style="{StaticResource PlangSmallIconStyle}" Data="{x:Static icons:PuiIconCatalog.Close}" Width="8" Height="8" Opacity="0.7"/>
                    </Button>
                </Grid>

                <Button DockPanel.Dock="Left" Style="{StaticResource PlangToolbarButtonStyle}" Click="AddKey_Click"
                        ToolTip="新增一个 Key：在弹出的对话框里一次填好 Key、说明和中性值">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource PlangIconStyle}" Data="{x:Static icons:PuiIconCatalog.Plus}"/>
                        <TextBlock Text="新增 Key"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource PlangToolbarButtonStyle}" Click="RemoveKey_Click" ToolTip="删除选中的 Key（可多选）">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource PlangIconStyle}" Data="{x:Static icons:PuiIconCatalog.Trash}"/>
                        <TextBlock Text="删除 Key"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource PlangToolbarButtonStyle}" Click="EditRow_Click"
                        ToolTip="把选中这一行的全部文案（说明、中性值、每门启用的语言）摊在一个窗口里改">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource PlangIconStyle}" Data="{x:Static icons:PuiIconCatalog.Pencil}"/>
                        <TextBlock Text="编辑这一行"/>
                    </StackPanel>
                </Button>

                <Rectangle DockPanel.Dock="Left" Style="{StaticResource PlangToolbarSeparatorStyle}"/>

                <Button DockPanel.Dock="Left" Style="{StaticResource PlangToolbarButtonStyle}" Click="Save_Click"
                        ToolTip="保存并生成 C# 类（存盘后自动跑一遍代码生成，不用再单独点一次）">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource PlangIconStyle}" Data="{x:Static icons:PuiIconCatalog.Save}"/>
                        <TextBlock Text="保存"/>
                    </StackPanel>
                </Button>

                <Rectangle DockPanel.Dock="Left" Style="{StaticResource PlangToolbarSeparatorStyle}"/>

                <Button DockPanel.Dock="Left" Style="{StaticResource PlangToolbarButtonStyle}" Click="ExportCsv_Click" ToolTip="把当前表格导出成 CSV（发给翻译的人）">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource PlangIconStyle}" Data="{x:Static icons:PuiIconCatalog.Export}"/>
                        <TextBlock Text="导出 CSV"/>
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource PlangToolbarButtonStyle}" Click="ImportCsv_Click" ToolTip="从 CSV 导入/合并（按 Key 覆盖，出现新语言代码会自动加一列）">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource PlangIconStyle}" Data="{x:Static icons:PuiIconCatalog.Import}"/>
                        <TextBlock Text="导入 CSV"/>
                    </StackPanel>
                </Button>
            </DockPanel>
        </Border>

        <!-- ==================== 语言条 ==================== -->
        <!-- 每种语言一个 chip：点 chip 本体停用/启用（停用只是收起那一列、不参与生成，文案不丢），
             × 是移除，右上角小徽标是"这门语言还差几条没填"。 -->
        <Border Grid.Row="1" Padding="8,5"
                BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Text="语言" Style="{StaticResource PlangCaptionStyle}" Margin="2,0,10,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource PlangToolbarButtonStyle}" Margin="4,0,0,0"
                        Click="AddLanguage_Click" ToolTip="从游戏自带的语言里点选，也可以手填第三方语言包的代码">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource PlangIconStyle}" Data="{x:Static icons:PuiIconCatalog.Plus}"/>
                        <TextBlock Text="添加语言"/>
                    </StackPanel>
                </Button>

                <!-- 一种语言都没加时给条提示，免得空着一条看不懂要干什么。 -->
                <TextBlock DockPanel.Dock="Left" Text="还没有语言，先点右边的「添加语言」——只填中性值的话游戏里所有语言都显示同一份文案。"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PlangCaptionStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Languages.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl ItemsSource="{Binding Languages}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource LanguageChipBorderStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <ToggleButton Style="{StaticResource LanguageChipToggleStyle}" IsChecked="{Binding Enabled}"
                                                      ToolTip="点一下停用/启用这门语言：停用只是收起表格里的这一列、不参与代码生成，已填的文案不会丢">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource PlangSmallIconStyle}" Data="{x:Static icons:PuiIconCatalog.Check}"
                                                      Width="8" Height="8" Margin="0,0,5,0" StrokeThickness="1.8"
                                                      Visibility="{Binding Enabled, Converter={StaticResource boolToVis}}"/>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Code}" FontFamily="Consolas" FontSize="10" Opacity="0.55"
                                                           Margin="6,0,0,0" VerticalAlignment="Center"/>
                                                <!-- 差几条没填。全填满了就不显示，别在没事的时候制造焦虑。 -->
                                                <Border CornerRadius="7" Padding="5,0" Margin="6,0,0,0" MinWidth="15" Height="15"
                                                        VerticalAlignment="Center" BorderThickness="1" Background="Transparent"
                                                        BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowValidationErrorBorderBrushKey}}"
                                                        Visibility="{Binding HasMissing, Converter={StaticResource boolToVis}}"
                                                        ToolTip="这门语言还有这么多条没填文案（取词时会退回中性值）">
                                                    <TextBlock Text="{Binding MissingCount}" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                               Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowValidationErrorTextBrushKey}}"/>
                                                </Border>
                                            </StackPanel>
                                        </ToggleButton>
                                        <Button Style="{StaticResource PlangIconButtonStyle}" Click="RemoveLanguage_Click" Tag="{Binding}"
                                                Margin="0,0,3,0" VerticalAlignment="Center"
                                                ToolTip="移除这门语言（各行已填的文案保留，重新用同样代码添加回来能找回）">
                                            <Path Style="{StaticResource PlangSmallIconStyle}" Data="{x:Static icons:PuiIconCatalog.Close}" Width="8" Height="8"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ==================== 表格 ==================== -->
        <Grid Grid.Row="2">
            <DataGrid x:Name="KeyGrid" ItemsSource="{Binding Rows}"
                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      HeadersVisibility="Column" SelectionUnit="FullRow" SelectionMode="Extended"
                      Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                      Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"
                      BorderThickness="0" MinRowHeight="30" ColumnHeaderHeight="30"
                      GridLinesVisibility="All"
                      HorizontalGridLinesBrush="{DynamicResource {x:Static platformui:EnvironmentColors.GridLineBrushKey}}"
                      VerticalGridLinesBrush="{DynamicResource {x:Static platformui:EnvironmentColors.GridLineBrushKey}}"
                      ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                      RowStyle="{StaticResource GridRowStyle}"
                      CellStyle="{StaticResource GridCellStyle}"
                      ClipboardCopyMode="IncludeHeader"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Key" Width="230"
                                        Binding="{Binding Key, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource KeyCellStyle}"
                                        EditingElementStyle="{StaticResource KeyCellEditStyle}"/>
                    <DataGridTextColumn Header="说明" Width="170"
                                        Binding="{Binding Comment, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource TextCellStyle}"
                                        EditingElementStyle="{StaticResource TextCellEditStyle}"/>
                    <DataGridTextColumn x:Name="NeutralColumn" Header="中性值" Width="240"
                                        Binding="{Binding NeutralValue, UpdateSourceTrigger=PropertyChanged}"
                                        ElementStyle="{StaticResource TextCellStyle}"
                                        EditingElementStyle="{StaticResource TextCellEditStyle}"/>
                    <!-- 语言列在代码里按 ViewModel.Languages 里启用的语言动态插入到这之后。 -->
                </DataGrid.Columns>
            </DataGrid>

            <!-- 空表提示。不吃鼠标，别挡住表格本身。 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Margin="0,40,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="还没有任何 Key" FontSize="14" HorizontalAlignment="Center" Opacity="0.7"
                           Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <TextBlock Text="点左上角的「新增 Key」加第一条文案" HorizontalAlignment="Center" Margin="0,6,0,0"
                           Style="{StaticResource PlangCaptionStyle}"/>
            </StackPanel>
        </Grid>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="3" Padding="10,4"
                BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource PlangCaptionStyle}"
                           Text="{Binding RowCount, StringFormat='{}{0} 个 Key'}"/>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource PlangCaptionStyle}" Margin="10,0,0,0"
                           Text="{Binding EnabledLanguageCount, StringFormat='{}{0} 种语言启用'}"/>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource PlangCaptionStyle}" Margin="10,0,0,0" Text="● 未保存"
                           Visibility="{Binding IsDirty, Converter={StaticResource boolToVis}}"/>
                <TextBlock DockPanel.Dock="Right" Style="{StaticResource PlangCaptionStyle}" Text="{Binding StatusMessage}"
                           TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>

        <!-- 启动覆盖层：仅 Tool Window 入口显示；新建/打开现有文件后隐藏 -->
        <Grid x:Name="StartOverlay" Grid.RowSpan="4" Panel.ZIndex="100">
            <Rectangle Fill="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}" Opacity="0.97"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Path Width="40" Height="40" Stretch="Uniform" Fill="Transparent" Margin="0,0,0,14"
                      HorizontalAlignment="Center"
                      Stroke="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"
                      StrokeThickness="1" Opacity="0.5" Data="{x:Static icons:PuiIconCatalog.Fallback}"/>
                <TextBlock Text="PLang 本地化编辑器" FontSize="18" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,0,0,6"
                           Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
                <TextBlock Text="新建一个 .plang，或者打开已有的继续编辑" Style="{StaticResource PlangCaptionStyle}"
                           HorizontalAlignment="Center" Margin="0,0,0,22"/>
                <Button Content="新建" Width="200" Height="34" Style="{StaticResource PlangDialogButtonStyle}" IsDefault="True" Click="New_Click"/>
                <Control Height="8"/>
                <Button Content="打开现有" Width="200" Height="34" Style="{StaticResource PlangDialogButtonStyle}" Click="Open_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
