<!--
    PLang 编辑器和它那几个对话框共用的一套外观：所有颜色都走 VS 平台主题的动态资源
    （platformui:*Colors.*BrushKey），亮/暗/蓝主题自动跟随，不写死任何色值；圆角、间距、字号
    统一在这里定，各个 XAML 只管布局，不再各自调样式。
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0">

    <!-- ============ 文字 ============ -->

    <Style x:Key="PlangTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
    </Style>

    <!-- 次要说明文字：小一号 + 降透明度，比另调一个灰色更能同时适配亮/暗主题。 -->
    <Style x:Key="PlangCaptionStyle" TargetType="TextBlock" BasedOn="{StaticResource PlangTextStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Opacity" Value="0.6"/>
    </Style>

    <Style x:Key="PlangFieldLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource PlangTextStyle}">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Opacity" Value="0.75"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="PlangDialogTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PlangTextStyle}">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ============ 输入框 ============ -->

    <Style x:Key="PlangTextBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextBrushKey}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBackgroundBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderBrushKey}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextBrushKey}}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ComboBoxSelectionBrushKey}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <!-- 不要在这儿再套一层 Margin="{TemplateBinding Padding}"：TextBoxBase 自己就会
                             把 Padding 应用到文本上（默认模板也没绑），再绑一次内边距会翻倍。 -->
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                      HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderFocusedBrushKey}}"/>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBackgroundFocusedBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBackgroundDisabledBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderDisabledBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextDisabledBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Key 用等宽字体：它是标识符不是文案，一眼能看出 . 和 _ 的位置。 -->
    <Style x:Key="PlangKeyTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource PlangTextBoxStyle}">
        <Setter Property="FontFamily" Value="Consolas"/>
    </Style>

    <!-- 输入框里的占位提示：TextBox 自己没有 Watermark，压一层不吃鼠标的 TextBlock，
         靠 DataTrigger 判空显示/隐藏。用的地方把 Binding 指到那个 TextBox 上。 -->
    <Style x:Key="PlangWatermarkStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxWatermarkBrushKey}}"/>
        <Setter Property="IsHitTestVisible" Value="False"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="7,0,0,0"/>
        <Setter Property="FontSize" Value="11"/>
    </Style>

    <!-- ============ 按钮 ============ -->

    <!--
        工具栏按钮：透明底、悬停高亮、图标+文字横排。
        Focusable=False 是要紧的：正在编辑某个单元格时点工具栏，焦点不该被从表格里抢走——
        抢走了当前行/当前格的状态就跟着乱，"编辑这一行"之类按选中项干活的命令会找不到目标。
        VS 自己的工具栏按钮也是不接受键盘焦点的。
    -->
    <Style x:Key="PlangToolbarButtonStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Margin" Value="1,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMenuItemMouseOverBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMenuItemMouseOverTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMouseDownBackgroundBeginBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 对话框底部的按钮。IsDefault=True 的那个自动变成主按钮配色，不用再单独套一个样式。 -->
    <Style x:Key="PlangDialogButtonStyle" TargetType="Button">
        <Setter Property="MinWidth" Value="86"/>
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonTextBrushKey}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonBrushKey}}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonBorderBrushKey}}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDefault" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonDefaultBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonBorderDefaultBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonDefaultTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonHoverBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonBorderHoverBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonHoverTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonPressedBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonBorderPressedBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonPressedTextBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonDisabledBrushKey}}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonBorderDisabledBrushKey}}"/>
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonDisabledTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 只有一个小图标的按钮（chip 上的 ×、搜索框里的清除）。同样不抢焦点，理由见上。 -->
    <Style x:Key="PlangIconButtonStyle" TargetType="Button">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMenuItemMouseOverBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 图标 ============ -->

    <!-- PuiIconCatalog 里的几何图形都是 16x16 网格上的描边图案，只给形状、颜色由样式统一绑主题文字色。 -->
    <Style x:Key="PlangIconStyle" TargetType="Path">
        <Setter Property="Width" Value="13"/>
        <Setter Property="Height" Value="13"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Setter Property="Fill" Value="Transparent"/>
        <Setter Property="Stroke" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        <Setter Property="StrokeThickness" Value="1.3"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PlangSmallIconStyle" TargetType="Path" BasedOn="{StaticResource PlangIconStyle}">
        <Setter Property="Width" Value="9"/>
        <Setter Property="Height" Value="9"/>
        <Setter Property="Margin" Value="0"/>
    </Style>

    <Style x:Key="PlangToolbarSeparatorStyle" TargetType="Rectangle">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="6,7"/>
        <Setter Property="Fill" Value="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarToolBarSeparatorBrushKey}}"/>
    </Style>

    <!-- ============ 滚动条 ============ -->

    <!-- 细身滚动条：默认 WPF 那套在 VS 暗色主题下是一条浅灰，很出戏。去掉两头的箭头按钮
         （轨道两端仍然可以点着翻页，只是不画出来），剩一条 12px 的轨道 + 圆角滑块。 -->
    <Style x:Key="PlangScrollThumbStyle" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bd" CornerRadius="3" Margin="2"
                            Background="{DynamicResource {x:Static platformui:EnvironmentColors.ScrollBarThumbBackgroundBrushKey}}"/>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ScrollBarThumbMouseOverBackgroundBrushKey}}"/>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ScrollBarThumbPressedBackgroundBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlangScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ScrollBarBackgroundBrushKey}}"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="MinWidth" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource PlangScrollThumbStyle}"/>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto"/>
                <Setter Property="MinWidth" Value="0"/>
                <Setter Property="Height" Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- 隐式套上：合并了这份字典的那棵树里所有滚动条都跟着换，不用一处处指定。 -->
    <Style TargetType="ScrollBar" BasedOn="{StaticResource PlangScrollBarStyle}"/>

    <!-- ============ 容器 ============ -->

    <!-- 对话框/面板里的一块内容区。 -->
    <Style x:Key="PlangCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"/>
        <Setter Property="Background" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowContentGridBrushKey}}"/>
    </Style>

</ResourceDictionary>
