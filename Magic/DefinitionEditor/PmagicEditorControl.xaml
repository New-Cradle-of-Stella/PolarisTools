<UserControl x:Class="PolarisTools.Magic.DefinitionEditor.PmagicEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d" d:DesignHeight="520" d:DesignWidth="900"
             Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"
             Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="boolToVis"/>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- 需要填的框描一圈边。这是提示不是诊断：没有等级、没有编号，
             底下那一行会说清该填什么。 -->
        <Style x:Key="HintableBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsValue}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFCE7B7B"/>
                    <Setter Property="BorderThickness" Value="1"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 表头与单元格必须显式取 VS 的主题色：DataGrid 的默认模板用的是系统色，
             在 VS 深色主题下就是深底配深字，表头看起来像空的。只改属性不换模板，
             默认模板自带的列宽拖拽把手继续可用。 -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource {x:Static platformui:HeaderColors.DefaultBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:HeaderColors.DefaultTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:HeaderColors.SeparatorLineBrushKey}}"/>
            <Setter Property="SeparatorBrush" Value="{DynamicResource {x:Static platformui:HeaderColors.SeparatorLineBrushKey}}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部横幅：只在文件读不下去时出现（XML 坏了、有认不出的元素、版本过新）。 -->
        <Border Grid.Row="0" Margin="0,0,0,10" Padding="8,6"
                Visibility="{Binding IsReadOnly, Converter={StaticResource boolToVis}}"
                BorderThickness="1" BorderBrush="#66FF6B6B" Background="#22FF6B6B">
            <TextBlock TextWrapping="Wrap">
                <Run Text="Opened read-only:" FontWeight="SemiBold"/>
                <Run Text="{Binding StatusMessage, Mode=OneWay}"/>
            </TextBlock>
        </Border>

        <Grid Grid.Row="1" IsEnabled="{Binding IsEditable}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ==================== 左栏：基本属性 ==================== -->
            <DockPanel Grid.Column="0">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Base properties"/>

                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="Id *" Margin="0,0,0,2"/>
                    <TextBox Text="{Binding MagicId, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IdNeedsValue}" Value="True">
                                        <Setter Property="BorderBrush" Value="#FFCE7B7B"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.7"
                               Text="Stable string id, at least two dot-separated segments (mymod.fireball). Save files store the numeric id PolarisMagic assigns to it, so changing this later orphans what players already learned."/>
                    <TextBlock Margin="0,0,0,10" TextWrapping="Wrap" Opacity="0.7"
                               Text="Starred fields have no default worth relying on: the vanilla magic data resets them on every cast."/>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding BaseFields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" Margin="0,0,0,2"/>
                                    <TextBox Style="{StaticResource HintableBox}"
                                             Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- ==================== 右栏：自定义静态属性 ==================== -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Text="Custom static properties"/>

                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                    <Button Content="Add" Width="72" Margin="0,0,6,0" Click="OnAdd"/>
                    <Button Content="Move up" Width="86" Margin="0,0,6,0" Click="OnMoveUp"/>
                    <Button Content="Move down" Width="94" Click="OnMoveDown"/>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7"
                               Text="Row order is the generated property order."/>
                </StackPanel>

                <DataGrid x:Name="PropertyGrid"
                          ItemsSource="{Binding Properties}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Width="*"
                                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                        <!-- 用模板列而不是 DataGridComboBoxColumn：后者的 ItemsSource 是列级属性，
                             绑不到行上的 TypeChoices。 -->
                        <DataGridTemplateColumn Header="Type" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding TypeChoices}"
                                              SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                              BorderThickness="0" Background="Transparent"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Value" Width="*"
                                            Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}"/>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="&#xD7;" ToolTip="Delete this property"
                                            Padding="0" Width="22" Height="20" Click="OnDelete"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

        <!-- ==================== 提示 ====================
             一行字，说清哪里还要填什么。没东西要说时整行隐藏——不留一个空的"诊断"面板占地方。 -->
        <TextBlock Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="#FFCE7B7B"
                   Text="{Binding Hint}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Hint}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
