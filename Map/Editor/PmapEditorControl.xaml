<UserControl x:Class="PolarisTools.Map.Editor.PmapEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
             Foreground="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}">
    <UserControl.Resources>
        <SolidColorBrush x:Key="BlueprintAccent" Color="#4F78A8"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="0,2,0,7"/>
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBackgroundBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextBrushKey}}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderBrushKey}}"/>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Opacity" Value="0.68"/>
        </Style>
        <Style x:Key="PanelTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="8,7" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                Background="{DynamicResource {x:Static platformui:EnvironmentColors.CommandBarMenuBackgroundGradientBrushKey}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock Text="Zoom" VerticalAlignment="Center" Margin="8,0,4,0" Opacity=".65"/>
                    <ComboBox x:Name="ZoomBox" Width="68" SelectedIndex="2" SelectionChanged="Zoom_Changed">
                        <ComboBoxItem Content="50%" Tag="0.5"/>
                        <ComboBoxItem Content="75%" Tag="0.75"/>
                        <ComboBoxItem Content="100%" Tag="1"/>
                        <ComboBoxItem Content="150%" Tag="1.5"/>
                        <ComboBoxItem Content="200%" Tag="2"/>
                    </ComboBox>
                    <Button Content="Save" Click="Save_Click" Margin="8,0,2,0"/>
                    <Button Content="Full hot reload" Click="HotReload_Click" ToolTip="Push the complete XML and fully reload the current map. Requires [PMapHotFixEnabled]."/>
                    <Button Content="Preview originals" Click="PreviewOriginals_Click" ToolTip="Temporarily render only this PMAP's map chips from your local game and show them directly on the blueprint. Nothing is added to the project."/>
                    <Button Content="Clear preview" Click="ClearPreview_Click" ToolTip="Delete the temporary original-asset preview directory."/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="18" Height="18" Background="{StaticResource BlueprintAccent}" Margin="0,0,8,0">
                        <TextBlock Text="M" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="PMap Blueprint" Style="{StaticResource PanelTitle}"/>
                        <TextBlock x:Name="StatusText" Text="Ready" FontSize="10" Opacity=".62"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="225" MinWidth="170"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="270" MinWidth="220"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <Border DockPanel.Dock="Top" Padding="9,7" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <StackPanel>
                        <TextBlock Text="LAYERS / CONTENT" Style="{StaticResource PanelTitle}" Margin="0,0,0,5"/>
                        <WrapPanel>
                            <Button Content="+ Layer" Click="AddLayer_Click"/>
                            <Button Content="+ Chip" Click="AddChip_Click"/>
                            <Button Content="+ Pic" Click="AddPicture_Click"/>
                            <Button Content="+ LP" Click="AddLabelPoint_Click"/>
                            <Button Content="+ GRD" Click="AddGradation_Click"/>
                            <Button Content="+ SM" Click="AddSubMap_Click"/>
                            <Button Content="+ Joint" Click="AddJoint_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Button DockPanel.Dock="Bottom" Content="Delete selected" Click="Delete_Click" Margin="8"/>
                <TreeView x:Name="MapTree" BorderThickness="0" SelectedItemChanged="Tree_SelectedItemChanged"
                          Background="Transparent" Padding="5"/>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>

            <Grid Grid.Column="2" Background="#FFE6E9ED">
                <ScrollViewer x:Name="CanvasScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              CanContentScroll="False" Padding="34">
                    <Canvas x:Name="BlueprintCanvas" Background="#FFF4F6F8" ClipToBounds="False"
                            RenderOptions.EdgeMode="Aliased"/>
                </ScrollViewer>
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="7,4"
                        Background="#D91B1E22" CornerRadius="3">
                    <TextBlock x:Name="CoordinateText" Text="28 px / cell · X → · Y ↓" Foreground="#FFD7DDE5" FontFamily="Consolas" FontSize="11"/>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch"/>

            <DockPanel Grid.Column="4">
                <Border DockPanel.Dock="Top" Padding="10,8" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}">
                    <TextBlock Text="INSPECTOR" Style="{StaticResource PanelTitle}"/>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="11,10">
                        <TextBlock Text="Map" FontWeight="SemiBold" Margin="0,0,0,7"/>
                        <TextBlock Text="Key" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MapKeyBox" TextChanged="MapInspector_Changed"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="Width" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MapWidthBox" TextChanged="MapInspector_Changed"/></StackPanel>
                            <StackPanel Grid.Column="2"><TextBlock Text="Height" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MapHeightBox" TextChanged="MapInspector_Changed"/></StackPanel>
                        </Grid>
                        <TextBlock Text="Background · #RRGGBB[AA]" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MapBackgroundBox" TextChanged="MapInspector_Changed"/>
                        <TextBlock Text="Map comment / META" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MapCommentBox" TextChanged="MapInspector_Changed" AcceptsReturn="True" MinHeight="45"/>
                        <TextBlock Text="CSP expected, then keys · one per line" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="MapCspExpectedBox" TextChanged="MapInspector_Changed"/>
                        <TextBox x:Name="MapCspKeysBox" TextChanged="MapInspector_Changed" AcceptsReturn="True" MinHeight="42"/>
                        <TextBlock Text="Editor additional · one per line" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MapAdditionalBox" TextChanged="MapInspector_Changed" AcceptsReturn="True" MinHeight="42"/>
                        <TextBlock Text="Mesh rects · index,x,y,width,height" Style="{StaticResource FieldLabel}"/><TextBox x:Name="MapMeshRectsBox" TextChanged="MapInspector_Changed" AcceptsReturn="True" MinHeight="55"/>

                        <Border Height="1" Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}" Margin="0,7,0,12"/>

                        <StackPanel x:Name="LayerInspector" Visibility="Collapsed">
                            <TextBlock Text="Layer" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <TextBlock Text="Name" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LayerNameBox" TextChanged="LayerInspector_Changed"/>
                            <CheckBox x:Name="LayerKeyBox" Content="Key layer" Checked="LayerInspector_Changed" Unchecked="LayerInspector_Changed" Margin="0,2,0,8"/>
                            <TextBlock Text="Editor color" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LayerColorBox" TextChanged="LayerInspector_Changed"/>
                            <TextBlock Text="Layer comment / META" Style="{StaticResource FieldLabel}"/><TextBox x:Name="LayerCommentBox" TextChanged="LayerInspector_Changed" AcceptsReturn="True" MinHeight="45"/>
                        </StackPanel>

                        <StackPanel x:Name="ElementInspector" Visibility="Collapsed">
                            <TextBlock x:Name="ElementTitle" Text="Element" FontWeight="SemiBold" Margin="0,0,0,7"/>
                            <TextBlock Text="Id" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementIdBox" TextChanged="ElementInspector_Changed"/>
                            <TextBlock Text="Label · editor only" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementLabelBox" TextChanged="ElementInspector_Changed"/>
                            <TextBlock Text="Color · editor / Joint runtime" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementColorBox" TextChanged="ElementInspector_Changed"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="X" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementXBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Y" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementYBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                            </Grid>
                            <StackPanel x:Name="ImageElementInspector">
                                <TextBlock Text="Image source" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementImageBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Pattern id" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementPatternBox" TextChanged="ElementInspector_Changed"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Rotation" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementRotationBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Opacity %" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementOpacityBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                </Grid>
                                <CheckBox x:Name="ElementFlipBox" Content="Flip horizontally" Checked="ElementInspector_Changed" Unchecked="ElementInspector_Changed"/>
                            </StackPanel>
                            <StackPanel x:Name="RectElementInspector" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Width" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementWidthBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Height" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementHeightBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                </Grid>
                            </StackPanel>
                            <StackPanel x:Name="LabelPointInspector" Visibility="Collapsed">
                                <TextBlock Text="LP key" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementKeyBox" TextChanged="ElementInspector_Changed"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Focus X" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementFocusXBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Focus Y" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementFocusYBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Command" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementCommandBox" TextChanged="ElementInspector_Changed" AcceptsReturn="True" MinHeight="45"/>
                                <TextBlock Text="Comment / META" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementCommentBox" TextChanged="ElementInspector_Changed" AcceptsReturn="True" MinHeight="45"/>
                            </StackPanel>
                            <StackPanel x:Name="GradationInspector" Visibility="Collapsed">
                                <TextBlock Text="GRD key" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GradationKeyBox" TextChanged="ElementInspector_Changed"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Order 0..6" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GradationOrderBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Direction 0..13" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GradationDirectionBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Start color" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GradationStartColorBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="End color" Style="{StaticResource FieldLabel}"/><TextBox x:Name="GradationEndColorBox" TextChanged="ElementInspector_Changed"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Slicer columns" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SlicerColumnsBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Slicer rows" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SlicerRowsBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                </Grid>
                                <TextBlock Text="Internal X · comma-separated" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SlicerInternalXBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Internal Y · comma-separated" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SlicerInternalYBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Levels · comma-separated" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SlicerLevelsBox" TextChanged="ElementInspector_Changed"/>
                            </StackPanel>
                            <StackPanel x:Name="SubMapInspector" Visibility="Collapsed">
                                <TextBlock Text="Target map key" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubMapTargetBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Base X,Y" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubMapBaseBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Scale X,Y" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubMapScaleBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Scroll X,Y" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubMapScrollBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Order, repeat X, repeat Y" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubMapOrderRepeatBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Interval X,Y" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubMapIntervalBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Camera length" Style="{StaticResource FieldLabel}"/><TextBox x:Name="SubMapCameraBox" TextChanged="ElementInspector_Changed"/>
                            </StackPanel>
                            <StackPanel x:Name="JointInspector" Visibility="Collapsed">
                                <TextBlock Text="Thickness 0..255" Style="{StaticResource FieldLabel}"/><TextBox x:Name="JointThicknessBox" TextChanged="ElementInspector_Changed"/>
                                <TextBlock Text="Points · one per line: x,y[,chipId]" Style="{StaticResource FieldLabel}"/><TextBox x:Name="JointPointsBox" TextChanged="ElementInspector_Changed" AcceptsReturn="True" MinHeight="100"/>
                            </StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Visual width" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementVisualWidthBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Visual height" Style="{StaticResource FieldLabel}"/><TextBox x:Name="ElementVisualHeightBox" TextChanged="ElementInspector_Changed"/></StackPanel>
                            </Grid>
                        </StackPanel>

                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" FontSize="10" Opacity=".55"
                                   Text="Original assets are extracted only to a system temp folder on explicit request and opened in your installed PixelLiner. They are never copied into the project or package."/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
