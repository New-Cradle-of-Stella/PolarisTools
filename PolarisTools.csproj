<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net472</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<UseWPF>true</UseWPF>
		<ImplicitUsings>disable</ImplicitUsings>

		<!-- VSIX -->
		<VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
		<GeneratePkgDefFile>true</GeneratePkgDefFile>
		<UseCodebase>true</UseCodebase>
		<IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
		<IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
		<IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
		<CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<CreateVsixContainer>true</CreateVsixContainer>
		<DeployExtension>true</DeployExtension>
	</PropertyGroup>

	<ItemGroup>
		<ProjectCapability Include="CreateVsixContainer" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="gong-wpf-dragdrop" Version="4.0.0" />
		<PackageReference Include="HandyControl" Version="3.5.1" />
		<PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" ExcludeAssets="runtime" />
		<PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.8.739" PrivateAssets="all" />
		<PackageReference Include="EnvDTE" Version="17.*" />
		<PackageReference Include="EnvDTE80" Version="17.*" />
		<PackageReference Include="Nodify" Version="7.3.0" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="Microsoft.CSharp" />
		<Reference Include="System.Design" />
		<Reference Include="System.Windows.Forms" />
		<Reference Include="System.ComponentModel.Composition" />
	</ItemGroup>

	<ItemGroup>
		<VSCTCompile Include="PolarisToolsPackage.vsct">
			<ResourceName>Menus.ctmenu</ResourceName>
			<Generator>VsctGenerator</Generator>
		</VSCTCompile>
	</ItemGroup>

	<!--
    工具侧与游戏侧共用同一份 PEVT 语言核心（词法、语法、类型、诊断），不允许各自维护一份解析器
    悄悄写歪。$(PolarisDir) 见 Directory.Build.props——与上面链接 .cs 文件用的是同一个兄弟目录约定，
    这里改成 ProjectReference 是因为 PEVT 前端是 PolarisEvent 的独立 netstandard2.0 目标，而不是零散源文件。
  -->
	<ItemGroup>
		<ProjectReference Include="$(PolarisDir)\PolarisEvent\PolarisEvent.csproj" />
	</ItemGroup>

	<!--
    从 Polaris（游戏侧运行时库，$(PolarisDir) 见 Directory.Build.props）链接过来编译的源文件。
    共同点是"两侧必须字字一致，抄成两份就会悄悄写歪"，而且都刻意不引用 UnityEngine/XX/
    BepInEx，net472 直接能编译：

      - .plang 的内存模型与 XML 读写：编辑器存盘、游戏内解析是同一份逻辑。
      - PUI 热重载线协议：opcode 数值、载荷字段与字段顺序因此天然一致，不必两份手抄
        靠人眼比对。颜色用中立的 PuiColor，两侧各自转成本框架的颜色类型。
      - "& 开头 = 本地化键"的判定：编译期展开（CSharpTextEmitter）、热重载运行期
        （PuiText）、编辑器预览（PuiPreviewRenderer）三条路径共用同一份规则，
        不会出现"预览按一套、真机按另一套"。真正查表的部分在游戏侧。
  -->
	<ItemGroup>
		<Compile Include="$(PolarisDir)\PolarisLang\Lang\PlangEntry.cs" Link="Lang\Shared\PlangEntry.cs" />
		<Compile Include="$(PolarisDir)\PolarisLang\Lang\PlangDocument.cs" Link="Lang\Shared\PlangDocument.cs" />
		<Compile Include="$(PolarisDir)\PolarisUI\PUI\HotReload\PuiWireProtocol.cs" Link="Pui\Shared\PuiWireProtocol.cs" />
		<Compile Include="$(PolarisDir)\PolarisCore\Localization\LocalizedString.cs" Link="Pui\Shared\LocalizedString.cs" />
		<Compile Include="$(PolarisDir)\PolarisParticles\Debugging\PEffectDebugProtocol.cs" Link="Particles\Shared\PEffectDebugProtocol.cs" />
		<Compile Include="$(PolarisDir)\PolarisParticles\PEffectSyntax.cs" Link="Particles\Shared\PEffectSyntax.cs" />
	</ItemGroup>

	<!--
    .pmagic 的文档模型、名字规则与 code-behind 签名契约，从 PolarisMagic 链接过来
    （$(PolarisMagicDir) 见 Directory.Build.props）。理由和上面那批一样，但这里的后果更直接：

      - 定义编辑器存盘与生成器解析是同一段 Parse 和同一份规范写法，因此不可能出现
        "编辑器存出来的文件生成器读不了"。
      - MagicCodeBehindContract 决定生成的 .pmagic.g.cs 引用哪个方法名/签名，也决定工具侧补出来的
        方法桩长什么样。抄成两份就会出现"补出来的桩和生成代码引用的不是同一个方法"。

    这批文件只依赖 System / System.Collections.Generic / System.Globalization / System.IO /
    System.Text / System.Text.RegularExpressions / System.Xml / System.Xml.Linq，
    不引用 Visual Studio、WPF、Unity、BepInEx、Harmony、原版程序集或 PolarisCore 运行对象。
  -->
	<ItemGroup>
		<Compile Include="$(PolarisMagicDir)\Authoring\MagicFormatVersion.cs" Link="Magic\Shared\MagicFormatVersion.cs" />
		<Compile Include="$(PolarisMagicDir)\Authoring\MagicIdentifier.cs" Link="Magic\Shared\MagicIdentifier.cs" />
		<Compile Include="$(PolarisMagicDir)\Authoring\MagicPropertyType.cs" Link="Magic\Shared\MagicPropertyType.cs" />
		<Compile Include="$(PolarisMagicDir)\Authoring\MagicDefinitionDocument.cs" Link="Magic\Shared\MagicDefinitionDocument.cs" />
		<Compile Include="$(PolarisMagicDir)\Authoring\MagicCodeBehindContract.cs" Link="Magic\Shared\MagicCodeBehindContract.cs" />
	</ItemGroup>

	<!-- Item Templates -->
	<ItemGroup>
		<!--
      模板里的 .cs 是待展开的文本（含 $rootnamespace$ 之类的替换参数），不是本项目的源码。
      SDK 风格项目默认把 **\*.cs 全部纳入编译，不排掉的话它们会被当成真源文件编译并因为
      那些 $ 参数报一串 CS1056。
    -->
		<Compile Remove="ItemTemplates\**\*.cs" />
		<None Include="ItemTemplates\**\*.*" />
		<VSIXSourceItem Include="ItemTemplates\Polaris\PuiFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\PuiFile</VSIXSubPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="ItemTemplates\Polaris\PuislnFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\PuislnFile</VSIXSubPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="ItemTemplates\Polaris\PlangFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\PlangFile</VSIXSubPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="ItemTemplates\Polaris\PevtFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\PevtFile</VSIXSubPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="ItemTemplates\Polaris\PactorFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\PactorFile</VSIXSubPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="ItemTemplates\Polaris\PactorExtensionFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\PactorExtensionFile</VSIXSubPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="ItemTemplates\Polaris\PEffectFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\PEffectFile</VSIXSubPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="ItemTemplates\Polaris\PevtStagingFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\PevtStagingFile</VSIXSubPath>
		</VSIXSourceItem>
		<VSIXSourceItem Include="ItemTemplates\Polaris\MagicFile\**\*.*">
			<VSIXSubPath>ItemTemplates\Polaris\MagicFile</VSIXSubPath>
		</VSIXSourceItem>
	</ItemGroup>

	<!--
    关键：把 PackageReference 解析出来的 copy-local 程序集打进 VSIX。
    你原来的 Content Include="$(OutputPath)Nodify.dll" 经常拿不到文件。
  -->
	<PropertyGroup>
		<GetVsixSourceItemsDependsOn>$(GetVsixSourceItemsDependsOn);IncludePackageReferenceAssembliesInVsix</GetVsixSourceItemsDependsOn>
	</PropertyGroup>

	<Target Name="IncludePackageReferenceAssembliesInVsix" DependsOnTargets="ResolveReferences">
		<!--
      直接扫 $(OutputPath) 里实际产出的 dll，不再筛 @(ReferencePath) 的 CopyLocal 元数据。
      已用诊断 target 核实过：CopyLocalLockFileAssemblies=true 让 SDK 正确把 System.Buffers/
      System.Memory/System.Numerics.Vectors/System.Runtime.CompilerServices.Unsafe/
      System.Threading.Tasks.Extensions/Microsoft.Bcl.AsyncInterfaces 这六个 BCL 兼容 shim
      拷进了 bin\——但它们在 ResolveReferences 阶段的 @(ReferencePath) 上却是
      CopyLocal=false（原因不明，大概率是 NuGet 资产去重逻辑对这批"传递依赖版本已被更高版本
      覆盖"的程序集提前打了标）。按 CopyLocal 筛选的旧写法因此漏掉这六个，装到一台没有这些
      shim 的干净 VS 上，第一次用到 CommunityToolkit.Mvvm/Nodify 就会 FileNotFoundException。
      扫 $(OutputPath) 才是 ground truth：SDK 真的把它拷到那里了，就该带进 VSIX；
      多带一份不会有坏处——宿主进程如果已经有同名程序集，CLR 绑定就近解析，不会撞车。
    -->
		<ItemGroup>
			<VsixOutputDll Include="$(OutputPath)*.dll" Exclude="$(OutputPath)$(AssemblyName).dll" />
			<!-- 只打第三方，不打 VS SDK/宿主进程自带的那堆（PresentationCore 等 WPF 核心程序集、
           EnvDTE 系列、Microsoft.VisualStudio.*、Microsoft.Build.* 都由 devenv.exe 自己提供，
           重复打包只会增大体积，个别情况下还可能因为版本不一致触发装配冲突）。 -->
			<!--
        Microsoft.CodeAnalysis*（含它拖来的 System.Collections.Immutable /
        System.Reflection.Metadata）同样由宿主提供，必须排除。

        它是 PolarisEvent 为 `$raw cs` 的 PEVT8007-8010 带来的传递依赖：那一段需要真正的 C#
        语义分析。但 devenv.exe 自己就装着 Roslyn，VSIX 再打一份 12 MB 不仅让包从 5 MB 涨到
        17 MB，还会在同一个进程里出现两个版本的 Microsoft.CodeAnalysis——装配绑定撞车的报错
        极难定位。

        因此工具侧不要 new PevtRoslynRawCsCompiler()，而要通过 Core 的端口
        IPevtRawCsCompiler / IPevtRawCsAnalyzer 接 Visual Studio 自己那一份 Roslyn：包装规则、
        类型映射、缓存和诊断编号仍然全部来自 PolarisEvent，两侧不会各写一套。
      -->
			<VSIXSourceItem Include="@(VsixOutputDll)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('Microsoft.VisualStudio')) == false
                                 and $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.Build')) == false
                                 and $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.CodeAnalysis')) == false
                                 and '%(Filename)' != 'System.Collections.Immutable'
                                 and '%(Filename)' != 'System.Reflection.Metadata'
                                 and '%(Filename)' != 'EnvDTE'
                                 and '%(Filename)' != 'EnvDTE80'
                                 and '%(Filename)' != 'stdole'
                                 and '%(Filename)' != 'Microsoft.CSharp'
                                 and '%(Filename)' != 'PresentationCore'
                                 and '%(Filename)' != 'PresentationFramework'
                                 and '%(Filename)' != 'WindowsBase'
                                 and '%(Filename)' != 'System.Xaml'">
				<VSIXSubPath>.</VSIXSubPath>
			</VSIXSourceItem>
		</ItemGroup>
	</Target>
</Project>
