<UserControl x:Class="PolarisTools.Pui.PuiVisualEditor.Controls.PuiColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:controls="clr-namespace:PolarisTools.Pui.PuiVisualEditor.Controls"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="ChannelLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}"/>
            <Setter Property="Opacity" Value="0.65"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Width" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 色块：点击展开 RGBA 调整面板；本身也是当前颜色的即时预览。 -->
        <Button x:Name="SwatchButton" Grid.Column="0" Width="22" Height="22" Margin="0,0,6,0"
                Padding="0" Cursor="Hand" Click="SwatchButton_Click"
                Background="Transparent" BorderThickness="0">
            <Border x:Name="SwatchPreview" Width="20" Height="20" CornerRadius="3"
                    BorderThickness="1" BorderBrush="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderBrushKey}}"/>
        </Button>

        <TextBox x:Name="HexBox" Grid.Column="1"
                 Background="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBackgroundBrushKey}}"
                 Foreground="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextBrushKey}}"
                 BorderBrush="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderBrushKey}}"
                 BorderThickness="1" Padding="4,3" FontFamily="Consolas"
                 MaxLength="8" CharacterCasing="Upper"
                 TextChanged="HexBox_TextChanged"
                 PreviewTextInput="HexBox_PreviewTextInput"
                 LostKeyboardFocus="HexBox_LostKeyboardFocus"/>

        <Popup x:Name="ChannelsPopup" PlacementTarget="{Binding ElementName=SwatchButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBackgroundBrushKey}}"
                    BorderBrush="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowBorderBrushKey}}"
                    BorderThickness="1" CornerRadius="4" Padding="10">
                <StackPanel Width="200">
                    <Border Height="28" CornerRadius="3" Margin="0,0,0,10"
                            BorderThickness="1" BorderBrush="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderBrushKey}}">
                        <Border x:Name="PopupPreview" CornerRadius="3"/>
                    </Border>

                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="R" Style="{StaticResource ChannelLabelStyle}"/>
                        <Slider x:Name="RSlider" Grid.Column="1" Minimum="0" Maximum="255" Margin="4,0"
                                Value="{Binding Value, ElementName=RBox, Mode=TwoWay}" ValueChanged="ChannelSlider_ValueChanged"/>
                        <controls:PuiNumberBox x:Name="RBox" Grid.Column="2" IsInteger="True" Min="0" Max="255"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="G" Style="{StaticResource ChannelLabelStyle}"/>
                        <Slider x:Name="GSlider" Grid.Column="1" Minimum="0" Maximum="255" Margin="4,0"
                                Value="{Binding Value, ElementName=GBox, Mode=TwoWay}" ValueChanged="ChannelSlider_ValueChanged"/>
                        <controls:PuiNumberBox x:Name="GBox" Grid.Column="2" IsInteger="True" Min="0" Max="255"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="B" Style="{StaticResource ChannelLabelStyle}"/>
                        <Slider x:Name="BSlider" Grid.Column="1" Minimum="0" Maximum="255" Margin="4,0"
                                Value="{Binding Value, ElementName=BBox, Mode=TwoWay}" ValueChanged="ChannelSlider_ValueChanged"/>
                        <controls:PuiNumberBox x:Name="BBox" Grid.Column="2" IsInteger="True" Min="0" Max="255"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="46"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="A" Style="{StaticResource ChannelLabelStyle}"/>
                        <Slider x:Name="ASlider" Grid.Column="1" Minimum="0" Maximum="255" Margin="4,0"
                                Value="{Binding Value, ElementName=ABox, Mode=TwoWay}" ValueChanged="ChannelSlider_ValueChanged"/>
                        <controls:PuiNumberBox x:Name="ABox" Grid.Column="2" IsInteger="True" Min="0" Max="255"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
