<UserControl x:Class="PolarisTools.Pui.PuiVisualEditor.Controls.PuiNumberBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Focusable="False" MinWidth="40" PreviewMouseWheel="UserControl_PreviewMouseWheel">
    <UserControl.Resources>
        <!-- 上/下 stepper 按钮：透明底 + hover 高亮，跟主编辑器里 Button 的 hover 配色一致，
             但不用完整的 Button 模板（那个模板有圆角/居中内容对齐等跟 4px 高的窄条不搭的设定）。 -->
        <Style x:Key="StepperButtonStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonHoverBrushKey}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static platformui:CommonControlsColors.ButtonPressedBrushKey}}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="RootBorder"
            Background="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBackgroundBrushKey}}"
            BorderBrush="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderBrushKey}}"
            BorderThickness="1" CornerRadius="3">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="EditBox" Grid.Column="0"
                     Background="Transparent" BorderThickness="0"
                     Padding="4,0,2,0" VerticalContentAlignment="Center"
                     Foreground="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxTextBrushKey}}"
                     TextChanged="EditBox_TextChanged"
                     PreviewTextInput="EditBox_PreviewTextInput"
                     PreviewKeyDown="EditBox_PreviewKeyDown"
                     GotKeyboardFocus="EditBox_GotKeyboardFocus"
                     LostKeyboardFocus="EditBox_LostKeyboardFocus"/>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <RepeatButton x:Name="UpButton" Grid.Row="0" Style="{StaticResource StepperButtonStyle}" Click="UpButton_Click">
                    <Path Data="M0,3.5 L3.5,0 L7,3.5 Z" Fill="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}" Opacity="0.7"/>
                </RepeatButton>
                <RepeatButton x:Name="DownButton" Grid.Row="1" Style="{StaticResource StepperButtonStyle}" Click="DownButton_Click">
                    <Path Data="M0,0 L3.5,3.5 L7,0 Z" Fill="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}" Opacity="0.7"/>
                </RepeatButton>
            </Grid>
        </Grid>
    </Border>
</UserControl>
