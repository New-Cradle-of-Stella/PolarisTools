<UserControl x:Class="PolarisTools.Pui.PuiVisualEditor.Controls.PuiResourcePicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             Focusable="False">
    <UserControl.Resources>
        <!-- 弹出层的配色写死成跟菜单栏/ComboBox 下拉同一套深色，不跟 VS 亮暗主题走：WPF 的
             Popup 内容用的是默认 Aero2 主题配色，CommonControlsColors.* 那些键管不到它
             （见 PuiVisualEditorControl.xaml 里 ComboBoxItem 样式上的同一段说明）。 -->
        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFF1F1F1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Stretch"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3E3E42"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF0E5E96"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- 收起状态：当前选中的资源（缩略图 + 字段引用）；点开展开搜索列表。 -->
        <Button x:Name="OpenButton" Grid.Column="0" Click="OpenButton_Click"
                HorizontalContentAlignment="Stretch" Padding="4,3"
                Background="{DynamicResource {x:Static platformui:CommonControlsColors.ComboBoxBackgroundBrushKey}}"
                ToolTip="Pick an MImage resource field ([PolarisResource] inside a [PolarisResourceFolder] class)">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="SelectedThumbBorder" Grid.Column="0" Width="18" Height="18" Margin="0,0,6,0"
                        Visibility="Collapsed"
                        BorderThickness="1" BorderBrush="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderBrushKey}}">
                    <Image x:Name="SelectedThumb" Stretch="Uniform"/>
                </Border>
                <TextBlock x:Name="SelectedText" Grid.Column="1" Text="(none)" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" FontSize="11"/>
                <Path Grid.Column="2" Data="M0,0 L4,4 L8,0 Z" Width="8" Height="4" Opacity="0.7"
                      HorizontalAlignment="Center" VerticalAlignment="Center"
                      Fill="{DynamicResource {x:Static platformui:CommonControlsColors.ComboBoxTextBrushKey}}"/>
            </Grid>
        </Button>

        <Button x:Name="ClearButton" Grid.Column="1" Width="22" Padding="0" Margin="4,0,0,0"
                Visibility="Collapsed" Click="ClearButton_Click"
                ToolTip="Clear the image resource (DsnDataImg.MI stays null)">
            <TextBlock Text="✕" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>

        <Popup x:Name="DropDown" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True" Opened="DropDown_Opened">
            <Border Background="#FF2D2D30" BorderBrush="#FF505050" BorderThickness="1"
                    MinWidth="{Binding ActualWidth, ElementName=OpenButton}" MaxWidth="380">
                <DockPanel>
                    <!-- 搜索框：字段引用和挂载路径都参与匹配，空格分隔的多个词是"全都要命中"。 -->
                    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="6" Padding="4,3"
                             Background="#FF1B1B1C" Foreground="#FFF1F1F1" BorderBrush="#FF505050" BorderThickness="1"
                             TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>

                    <TextBlock x:Name="EmptyHint" DockPanel.Dock="Top" Margin="8,0,8,8" FontSize="11"
                               Foreground="#FFB0B0B0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <ListBox x:Name="ResultList" MaxHeight="260" Background="Transparent" BorderThickness="0"
                             Foreground="#FFF1F1F1"
                             ItemContainerStyle="{StaticResource ResultItemStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             PreviewMouseLeftButtonUp="ResultList_PreviewMouseLeftButtonUp"
                             PreviewKeyDown="ResultList_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="26" Height="26" Margin="0,0,8,0"
                                            Background="#FF1B1B1C" BorderThickness="1" BorderBrush="#FF505050">
                                        <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="#FFB0B0B0"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
