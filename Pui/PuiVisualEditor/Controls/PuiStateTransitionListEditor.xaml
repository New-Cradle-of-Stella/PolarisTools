<UserControl x:Class="PolarisTools.Pui.PuiVisualEditor.Controls.PuiStateTransitionListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:platformui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:controls="clr-namespace:PolarisTools.Pui.PuiVisualEditor.Controls"
             xmlns:pui="clr-namespace:PolarisTools.Pui.PuiVisualEditor"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="RowIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <controls:PuiStateTriggerTypeToVisibilityConverter x:Key="triggerVisConverter"/>

        <DataTemplate x:Key="TransitionRowTemplate" DataType="{x:Type pui:PuiStateTransition}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ComboBox Grid.Column="0" Margin="0,0,4,0"
                          ItemsSource="{Binding TriggerTypeOptions, RelativeSource={RelativeSource AncestorType=controls:PuiStateTransitionListEditor}}"
                          DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding TriggerType, Mode=TwoWay}"
                          SelectionChanged="Row_SelectionChanged"/>

                <ComboBox Grid.Column="1" Margin="0,0,4,0"
                          ItemsSource="{Binding ButtonNames, RelativeSource={RelativeSource AncestorType=controls:PuiStateTransitionListEditor}}"
                          SelectedValue="{Binding ButtonName, Mode=TwoWay}"
                          SelectionChanged="Row_SelectionChanged"
                          Visibility="{Binding TriggerType, Converter={StaticResource triggerVisConverter}, ConverterParameter=ButtonClick}"/>

                <TextBox Grid.Column="1" Margin="0,0,4,0"
                         Text="{Binding EventKey, UpdateSourceTrigger=PropertyChanged}"
                         TextChanged="Row_TextChanged"
                         Visibility="{Binding TriggerType, Converter={StaticResource triggerVisConverter}, ConverterParameter=CustomEvent}"/>

                <TextBlock Grid.Column="1" Text="按 ESC / 取消键触发" VerticalAlignment="Center" Opacity="0.55" FontSize="11"
                           Visibility="{Binding TriggerType, Converter={StaticResource triggerVisConverter}, ConverterParameter=Cancel}"/>

                <CheckBox Grid.Column="2" Content="阻塞" VerticalAlignment="Center" Margin="0,0,4,0"
                          IsChecked="{Binding Blocking}" Click="Row_Changed"/>

                <Button Grid.Column="3" Style="{StaticResource RowIconButtonStyle}" Click="RemoveRow_Click" ToolTip="删除这一项">
                    <Path Data="{x:Static controls:PuiIconCatalog.Close}" Width="9" Height="9" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}" StrokeThickness="1.3"/>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Border BorderBrush="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBorderBrushKey}}"
            BorderThickness="1" CornerRadius="3"
            Background="{DynamicResource {x:Static platformui:CommonControlsColors.TextBoxBackgroundBrushKey}}">
        <DockPanel Margin="6">
            <Button DockPanel.Dock="Bottom" Style="{StaticResource RowIconButtonStyle}" HorizontalContentAlignment="Left"
                    Margin="0,2,0,0" Click="AddRow_Click">
                <StackPanel Orientation="Horizontal">
                    <Path Data="{x:Static controls:PuiIconCatalog.Plus}" Width="9" Height="9" Stretch="Uniform" Fill="Transparent"
                          Stroke="{DynamicResource {x:Static platformui:EnvironmentColors.ToolWindowTextBrushKey}}" StrokeThickness="1.3" Margin="0,0,4,0"/>
                    <TextBlock Text="添加状态连接点" FontSize="11" Opacity="0.8"/>
                </StackPanel>
            </Button>

            <ListBox x:Name="RowsListBox" BorderThickness="0" Background="Transparent"
                     ItemTemplate="{StaticResource TransitionRowTemplate}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="IsHitTestVisible" Value="True"/>
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
